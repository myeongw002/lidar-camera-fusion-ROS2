<?xml version="1.0"?>
<package format="3">
  <name>lidar_camera_fusion</name>
  <version>1.0.0</version>
  <description>Native ROS2 spherical LiDAR interpolation and calibrated camera fusion.</description>
  <maintainer email="edison.velasco@ua.es">epvs</maintainer>
  <license>GPL-3.0-only</license>
  <url type="repository">https://github.com/EPVelasco/lidar-camera-fusion</url>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <depend>armadillo</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
