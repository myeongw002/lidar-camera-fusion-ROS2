Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: velodyne
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1.0
    Plane: XY
  - Class: rviz_default_plugins/PointCloud2
    Name: Original LiDAR
    Enabled: true
    Topic:
      Value: /velodyne_points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Size (Pixels): 2
    Style: Points
    Position Transformer: XYZ
    Color Transformer: Intensity
  - Class: rviz_default_plugins/PointCloud2
    Name: Colored LiDAR
    Enabled: true
    Topic:
      Value: /points2
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Size (Pixels): 2
    Style: Points
    Position Transformer: XYZ
    Color Transformer: RGB8
  - Class: rviz_default_plugins/Image
    Name: Camera
    Enabled: true
    Topic:
      Value: /camera/color/image_raw
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  - Class: rviz_default_plugins/Image
    Name: Projected LiDAR
    Enabled: true
    Topic:
      Value: /pcOnImage_image
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  - Class: rviz_default_plugins/Image
    Name: Raw range image (32FC1 metres)
    Enabled: true
    Topic:
      Value: /range_image_raw
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  - Class: rviz_default_plugins/Image
    Name: Interpolated range image (32FC1 metres)
    Enabled: true
    Topic:
      Value: /range_image_interpolated
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
Window Geometry:
  Width: 1200
  Height: 800
